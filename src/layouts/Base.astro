---
// Font CSS imported here so Vite treats them as module imports,
// rewrites the ./files/*.woff2 paths, and copies font files into dist/.
// Importing via CSS @import inside a <style> block bypasses this and
// causes 404s in production (node_modules isn't deployed).
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/source-serif-4/opsz.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ray Shen',
  description = "I'm a full-stack engineer. I build products end to end.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ray-shen.me" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
