---
import { bio, headshot, name } from '../../data/site';
---

<section id="about" aria-labelledby="about-heading">
  <div class="container">
    <span class="section-index" aria-hidden="true">01</span>
    <h2 id="about-heading" class="section-heading">About</h2>
    <div class="about-inner reveal">
      <p class="about-bio">{bio}</p>
      {headshot && (
        <div class="headshot-wrap">
          <img
            src={headshot}
            alt={name}
            class="headshot"
            loading="lazy"
            decoding="async"
          />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
  }

  .about-bio {
    font-size: clamp(var(--text-base), 2vw, var(--text-lg));
    line-height: var(--leading-loose);
    color: var(--color-ink-muted);
    max-width: 38rem;
    flex: 1;
  }

  .headshot-wrap {
    flex-shrink: 0;
    width: clamp(120px, 16vw, 180px);
    isolation: isolate;
  }

  .headshot {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
    filter: grayscale(1) contrast(1.05);
    mix-blend-mode: multiply;
    opacity: 0.88;
    transition:
      filter 500ms var(--ease-out),
      opacity 500ms var(--ease-out);
  }

  .headshot:hover {
    filter: grayscale(0) contrast(1);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .headshot {
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .about-inner {
      flex-direction: column-reverse;
      gap: var(--space-4);
    }

    .headshot-wrap {
      width: clamp(100px, 40vw, 140px);
    }
  }
</style>
